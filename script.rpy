# Шаг 1: Настройка базы данных под новый сюжет
init python:
    import os

    def init_database():
        db_path = os.path.join(config.gamedir, "game_data.db")
        if not os.path.exists(db_path):
            with open(db_path, "w", encoding="utf-8") as f:
                f.write("id,guy_name,love_points,polina_status\n")

    def save_game_results(name, love, status):
        db_path = os.path.join(config.gamedir, "game_data.db")
        with open(db_path, "r", encoding="utf-8") as f:
            lines = f.readlines()
        next_id = len(lines)
        
        name = name.replace(",", "")
        status = status.replace(",", "")
        
        with open(db_path, "a", encoding="utf-8") as f:
            f.write(f"{next_id},{name},{love},{status}\n")

# Шаг 2: Сценарий про Полю и подкаты
label start:
    $ init_database()

    "Вы не представляете, сколько сил ушло на то, чтобы позвать ЕЁ на свидание."
    "Полина. Самая популярная девушка в округе. И сегодня она согласилась встретиться."

    $ guy_name = renpy.input("Как зовут нашего романтика?", default="Паша")
    $ guy_name = guy_name.strip()
    if not guy_name:
        $ guy_name = "Паша"

    $ love_points = 0

    "Вечер. Городской парк."
    "Вы замечаете Полину издалека. Она стоит у раскидистого дуба, лениво держа в руках дымящуюся сигарету."
    
    show polina at truecenter with dissolve
    
    guy_name "Привет, Поль! Отлично выглядишь."
    
    "Полина медленно переводит на вас взгляд, выпускает струйку дыма и усмехается."
    "Полина" "О, притащился-таки. Я думала, ты сольешься в последний момент."

    # Выбор 1: Первый подкат
    menu:
        "Сделать комплимент ее стилю":
            $ love_points += 1
            guy_name "У тебя классная куртка. Тебе идет этот стиль."
            "Полина" "Хах, спасибо, я знаю. Надеюсь, ты не полчаса придумывал этот комплимент, пока шел?"
            "Вы немного смутились, но Полина хотя бы улыбнулась."

        "Попросить прикурить (показать себя крутым)":
            $ love_points -= 1
            guy_name "О, сигаретка? Дай прикурить, а то свои дома забыл."
            "Полина" "Мальчик, тебе сколько лет? Стрелять сигареты на первом свидании — это мощный старт. Ладно, держи."
            "Вы закашлялись от непривычки. Полина откровенно заржала."

    "Вы идете по аллее. Атмосфера накаляется, нужно срочно исправить положение и завоевать её доверие."

    # Выбор 2: Действие во время прогулки
    menu:
        "Купить ей кофе и дорогую пироженку":
            $ love_points += 2
            guy_name "Поль, давай зайдем за кофе? Я угощаю, бери что хочешь."
            "Полина" "Ого, подгон от щедрого спонсора? Ладно, растопил мое сердечко на пару минут. Давай свой латте."
            "Кажется, ваши шансы немного выросли!"

        "Пошутить дворовый анекдот":
            $ love_points -= 2
            guy_name "Слушай анекдот: Заходят как-то в бар..."
            "Полина" "Боже... [guy_name], остановись. Твой кринж-метр сейчас взорвется. Пожалуйста, больше никогда не шути."
            "Полина закатила глаза. Земля уходит у вас из-под ног."

    "Свидание подходит к концу. Вы провожаете Полину до остановки."
    guy_name "Поль... ну как тебе вечер? Может, повторим?"

    if love_points >= 2:
        $ polina_status = "Зафрендзонен со стебом"
        "Полина" "Слушай, [guy_name]... Ты забавный. Правда. Как домашний хомячок. Давай останемся друзьями? Будешь таскать мне сумки."
    else:
        $ polina_status = "Жестко уничтожен морально"
        "Полина" "Повторим? Ты серьезно? Это были самые долгие два часа в моей жизни. Пока, романтик, найди себе кого попроще."

    "Грустный финал. Полина уезжает на автобусе, оставив вас наедине со своими мыслями."
    "Записываем уровень вашего провала в базу данных..."

    $ save_game_results(guy_name, love_points, polina_status)

    "Результаты свидания сохранены в файл 'game_data.db'!"
"Вы можете запустить игру заново под другим именем парня и попробовать набрать другие очки."
    
return