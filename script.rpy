init python:
    import os

    def init_database():
        db_path = os.path.join(config.gamedir, "game_data.db")
        if not os.path.exists(db_path):
            with open(db_path, "w", encoding="utf-8") as f:
                f.write("id,guy_name,love_points,polina_status\n")

    def save_game_results(name, love, status):
        db_path = os.path.join(config.gamedir, "game_data.db")
        with open(db_path, "r", encoding="utf-8") as f:
            lines = f.readlines()
        next_id = len(lines)
        
        name = name.replace(",", "")
        status = status.replace(",", "")
        
        with open(db_path, "a", encoding="utf-8") as f:
            f.write(f"{next_id},{name},{love},{status}\n")

label start:
    $ init_database()

    "Вы не представляете, сколько сил ушло на то, чтобы позвать ЕЁ на свидание."
    "Полина. Самая популярная девушка в округе. И сегодня она согласилась встретиться."

    $ guy_name = renpy.input("Как зовут нашего романтика?", default="Неудачник")
    $ guy_name = guy_name.strip()
    if not guy_name:
        $ guy_name = "Неудачник"

    $ love_points = 0
    scene ser_ponelki with fade
    play music "Memo Boy - brian is the most beautiful.mp3" fadein 2.0
    "Вечер. Серые панельки домов."
    "Вы замечаете Полину издалека. Она стоит у зассоного собаками угла многоэтажного дома, лениво держа в руках дымящуюся сигарету."
    transform poli_jump:
        easein 0.15 yoffset -30  
        easeout 0.15 yoffset 0 

    show poli classic:
        xalign 0.5   
        yalign 1.0  
        zoom 0.6    
    with dissolve

    guy_name "Привет, Поль! Отлично выглядишь."
    
    "Полина медленно переводит на вас взгляд, выпускает струйку дыма и усмехается."
    show poli mili at poli_jump
    with dissolve
    "Полина" "О, притащился-таки. Я думала, ты сольешься в последний момент."

    # Выбор 1: Подкатик
    menu:
        "Сделать комплимент ее стилю":
            $ love_points += 1
            guy_name "У тебя классная куртка. Тебе идет стиль альтушки."
            show poli classic
            with dissolve
            "Полина" "Хах, спасибо, я знаю. Надеюсь, ты не полчаса придумывал этот комплимент, пока шел?"
            "Вы немного смутились, но Полина хотя бы улыбнулась. И эта улыбка была лучшей из всех, что он только видел."

        "Попросить прикурить (показать себя крутым)":
            $ love_points -= 1
            guy_name "О, сигаретка? Дай прикурить, а то свои дома забыл, пока к тебе бежал."
            show poli zlaya at poli_jump
            with dissolve
            "Полина" "Мальчик, тебе сколько лет? Стрелять сигареты на первом свидании — это полный кринж."
            "Полина" "Ладно, малой, держи."
            "Вы закашлялись от непривычки. Полина откровенно заржала."
            show poli mili at poli_jump
            with dissolve
    "Вы идете вдоль домов, подходя к круглосуточному магазинчику. Атмосфера накаляется, нужно срочно исправить положение и завоевать её доверие."
    show poli classic
    with dissolve

    # Выбор 2: Знаки внимания
    menu:
        "Купить ей кофе и дорогую пироженку":
            $ love_points += 2
            guy_name "Поль, давай зайдем за кофе? Я угощаю, бери что хочешь!"
            show poli mili at poli_jump
            with dissolve
            "Полина" "Ого, подгон от щедрого спонсора? Ладно, растопил мое сердечко на пару минут."
            "Кажется, ваши шансы немного выросли! Альтушечка снова улыбнулась."

        "Пошутить дворовый анекдот":
            $ love_points -= 2
            guy_name "Слушай анекдот: Заходят как-то в бар..."
            show poli zlaya at poli_jump
            with dissolve
            "Полина" "Боже... [guy_name], остановись. У меня сейчас мозг взорвется. Пожалуйста, больше никогда не шути."
            "Полина закатила глаза. Земля уходит у вас из-под ног. Вы чувствуете, как в воздухе витает напряжение."
    
    scene skver with fade
    show poli classic:
        xalign 0.5 
        yalign 1.0 
        zoom 0.6
        "Я боялся дышать рядом с ней."
        "От Полины привычно пахло дешевыми сижками, спиртом от духов с маркетплейсов и лаком для волос. И это был такой... родной для меня запах."
        "Мы пошли дальше, медленно двигаясь по тротуару в сторону сквера."
        "Несмотря на вечер, на улице было полно людей: детишки катались на велосипедах, старушки у подъездов привычно разбирали личности прохожих..."
        "...а на площадках тусовались подростки, снимая очередные липсинги."
        "Все вокруг было таким привычным. Душевным. И приятным."
        "Я аккуратно посмотрел на Полюшку. Она полностью уткнулась в свой телефон."
        "Между нами снова повисло тяжелое молчание. Надо было срочно что-то сказать..."
        "Атмосфера становится чуть свободнее. Вы решаете, что пора переходить к более личной беседе."

    # Выбор 3: Развести ее на общение
    menu:
        "Спросить о ней":
            $ love_points += 1
            guy_name "Слушай, Поль, а чем ты вообще увлекаешься? Ну, кроме того, что разбиваешь сердца местным романтикам?"
            show poli mili at poli_jump
            with dissolve
            "Полина" "Хах. Ну, люблю хорошую музыку, качаться на качелях по ночам и залипать в сериалы."
            "Полина" "Стримеров вот люблю смотреть. Ща, покажу."
            "Девушка достает из черной сумочки свой телефон. Парень не очень разбирается, но вроде, это 11 апхон."
            show poli makan at poli_jump
            "На изображении был популярный человек. Вы оценили это."
            "Полина" "А что, собираешь на меня досье?"
            "Кажется, ей приятен ваш интерес!"


        "Рассказать о себе":
            $ love_points -= 1
            guy_name "Знаешь, я вообще парень серьезный. Занимаюсь программированием, в доту с пацанами играю, на складах вот..."
            show poli zlaya
            with dissolve
            "Полина" "О-о-о, остановись, профессор. Я чуть не уснула, пока ты перечислял свои достижения."
            "Полина" "Давай без душноты, ладно? Мы же не на собеседовании."
            "Вы почувствовали себя неловко. Полина явно не любит долгие монологи о чужих успехах."

    "Время летит незаметно. На город опускаются сумерки..."


    "Свидание подходит к концу. Вы провожаете Полину до остановки."
    play music "sloboda.mp3" fadeout 1.5 fadein 2.0
    scene ostanovka with fade
    show poli classic:
        xalign 0.5
        yalign 1.0
        zoom 0.6

    guy_name "Поль... ну как тебе вечер? Может, повторим?"

    if love_points >= 3:
        $ polina_status = "Зафрендзонен с нежностью"
        show poli mili at poli_jump
        with dissolve
        "Полина" "Слушай, [guy_name]... Ты забавный. Правда. Как домашний хомячок. Давай останемся друзьями? Будешь таскать мне сумки."
    else:
        $ polina_status = "Уничтожен морально"
        show poli shoke at poli_jump
        with dissolve
        "Полина" "Повторим? Ты серьезно?"
        "Полина" "Это были самые долгие 15 минут в моей жизни. Пока, романтик, найди себе кого попроще."

    "Грустный финал. Полина уезжает на автобусе, оставив вас наедине со своими мыслями."
    "Ну, ты пытался, чувак"

    $ save_game_results(guy_name, love_points, polina_status)
    stop music fadeout 0.5
    play sound "scream freddy.mp3"
    show misha at truecenter
    with vpunch
    $ renpy.pause(2.0, hard=True)
    hide freddy
    with dissolve

    "Что это сейчас было?! Сердце ушло в пятки, а перед глазами всё поплыло..."

with hpunch

"Вы можете запустить игру заново под другим именем парня и попробовать набрать другие очки."
